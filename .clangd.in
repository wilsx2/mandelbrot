CompileFlags:
  Add:
    - --cuda-path=@CLANGD_CUDA_PATH@
    - --cuda-gpu-arch=sm_@CLANGD_CUDA_ARCH@
    - -std=c++@CLANGD_CXX_STANDARD@
    - -I@CLANGD_SOURCE_DIR@/include
    - -isystem
    - @CLANGD_VCPKG_INCLUDE_DIR@
    - -isystem
    - @CLANGD_CUDA_INCLUDE_DIR@
    - -isystem
    - @CLANGD_CUDA_CCCL_INCLUDE_DIR@
