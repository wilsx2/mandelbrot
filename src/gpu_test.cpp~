#include "wacfrac/gpu/host_interface.hpp"
#include "wacfrac/io.hpp"
#include "wacfrac/viewport.hpp"
#include "wacfrac/resolution.hpp"
#include <print>

auto main() -> int {
    wacfrac::logging::init(0);
    std::println("Initializing renderer");
    wacfrac::GpuRenderer renderer {0, {1980, 1020}, wacfrac::ULTRA};
    std::println("Calling render func");
    auto pixels {renderer.render<std::complex<double>>({{-0.5, 0.0}, {2.5,2.5}}, 256, 8.0, false)};
    std::println("Saving to disk");
    wacfrac::write_ppm("gpubrot.ppm", {1980, 1020}, pixels);
    return 0;
}
